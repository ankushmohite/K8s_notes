---

apiVersion: v1

kind: Service

metadata:

  namespace: ecgcbackenderp

  name: erp-bud-buyer-be

  labels:

    app: erp-bud-buyer-be-app

spec:

  selector:

    app: erp-bud-buyer-be-app

    tier: backend

  type: NodePort

  ports:

    - name: http

      port: 11001                #container port

      targetPort: 11001           #Pod port

      nodePort: 31704       #If type is NodePort then use nodePort  

---

apiVersion: apps/v1

kind: Deployment

metadata:

  name: erp-bud-buyer-be

  namespace: ecgcbackenderp

  labels:

    app: erp-bud-buyer-be-app  

spec:

  replicas: 4

  selector:

    matchLabels:

      app: erp-bud-buyer-be-app

      tier: backend

  template:

    metadata:

      labels:

        app: erp-bud-buyer-be-app

        tier: backend

      name: erp-bud-buyer-be

    spec:

      containers:

        - image: docker-prod.ecgcindia.com:443/erp-bud-buyer-be.jar:R1.0.57_59

          name: erp-bud-buyer-be-container

          resources:

            requests:

              memory: "4Gi"

              cpu: "2"

            limits:

              memory: "10Gi"

              cpu: "4"                      

#          resources:

#            requests:

#              memory: "64Mi"

#              cpu: "250m"

#            limits:

#              memory: "128Mi"

#              cpu: "5000m"                        

#          ports:

#           - containerPort: 80

          env:

          - name: SPRING_PROFILES_ACTIVE

            value: "prod"

          - name: TZ

            value: Asia/Kolkata

          - name: JAVA_OPTS

            value: >-

                -XX:MaxRAMPercentage=70.0

                -XX:MinRAMPercentage=70.0

                -XX:+UseG1GC

                -XX:MaxGCPauseMillis=200

                -XX:+PrintGCDetails

                -XX:+PrintGCDateStamps

                -XX:+ExitOnOutOfMemoryError

                -XX:MaxMetaspaceSize=512m

                -XX:NativeMemoryTracking=summary

#      nodeSelector:

#                                                   size:medium          

      dnsConfig:

        searches:

          - ecgc.svc.cluster.local

          - ecgcbackenderp.svc.cluster.local

---

apiVersion: monitoring.coreos.com/v1

kind: ServiceMonitor

metadata:

  name: erp-bud-buyer-be

  namespace: ecgcbackenderp

spec:

  selector:

    matchLabels:

      app: erp-bud-buyer-be-app

  endpoints:

    - port: http

      path: /actuator/prometheus

      interval: 15s

 
