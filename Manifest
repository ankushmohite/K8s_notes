---

apiVersion: v1

kind: Service

metadata:

  namespace: ecgcbackenderp

  name: erp-cud-country-be

  labels:

    app: erp-cud-country-be-app

spec:

  selector:

    app: erp-cud-country-be-app

    tier: backend

  type: NodePort

  ports:

    - port: 11023                #container port

      targetPort: 11023           #Pod port

      nodePort: 31748       #If type is NodePort then use nodePort  

---

apiVersion: apps/v1

kind: Deployment

metadata:

  name: erp-cud-country-be

  namespace: ecgcbackenderp

  labels:

    app: erp-cud-country-be-app  

spec:

  replicas: 2

  selector:

    matchLabels:

      app: erp-cud-country-be-app

      tier: backend

  template:

    metadata:

      labels:

        app: erp-cud-country-be-app

        tier: backend

      name: erp-cud-country-be

    spec:

      containers:

        - image: docker-prod.ecgcindia.com:443/erp-cud-country-be.jar:R1.2.41_40

          name: erp-cud-country-be-container

#          resources:

#            requests:

#              memory: "64Mi"

#              cpu: "250m"

#            limits:

#              memory: "128Mi"

#              cpu: "500m"               

#          ports:

#           - containerPort: 80

          env:

          - name: SPRING_PROFILES_ACTIVE

            value: "prod"

          - name: TZ

            value: Asia/Kolkata

#      nodeSelector:

#             size:medium

      dnsConfig:

        searches:

          - ecgc.svc.cluster.local

          - ecgcbackenderp.svc.cluster.local

 

 
